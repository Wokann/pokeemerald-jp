gTVHoennTreasureInvestigatorsText00::
	.string "“ホウエン　おたから　たんていだん！”\p"
	.string "みんなー！\n"
	.string "かくしアイテム　みつけてるー！？\p"
	.string "きょうも　かくちで　もくげき　された\n"
	.string "ひみつの　じょうほうを　しょうかい　するよ！\p"
	.string "きょうの　おてがみは\n"
	.string "‘{STR_VAR_1}　はっけん！'に\l"
	.string "ついてだよー！！$"

gTVHoennTreasureInvestigatorsText01::
	.string "さっそく　よんでみるねー！\p"
	.string "⋯⋯たんていだんの　みなさん　こんにちは\p"
	.string "この　あいだ　{STR_VAR_2}さんが\n"
	.string "‘{STR_VAR_3}'で　なんと！\l"
	.string "‘{STR_VAR_1}'を　みつけて　いました\l"
	.string "もう　とっても　うらやましかったです\p"
	.string "⋯⋯やったね！　{STR_VAR_2}さん！\p"
	.string "テレビの　まえの　みんなも　まけずに\n"
	.string "ダウジングマシンを　つかって　さがしてね！\p"
	.string "きみの　とっておきの　じょうほう\n"
	.string "まってるよー！$"

